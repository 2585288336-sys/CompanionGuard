# Example server profile. Do not commit real keys.
COMPANIONGUARD_JUDGE_PROVIDER_TYPE = "openai_responses"
COMPANIONGUARD_JUDGE_PROVIDER_NAME = "DeepSeek"
COMPANIONGUARD_JUDGE_BASE_URL = "https://api.deepseek.com"
COMPANIONGUARD_JUDGE_MODEL = "deepseek-v4-pro"
COMPANIONGUARD_JUDGE_API_KEY = ""

# Optional independent LLM roles can be configured with the same naming scheme:
# COMPANIONGUARD_EVIDENCE_*
# COMPANIONGUARD_DIALOGUE_REPORT_*

# Alternatively, Cloud Secrets may use this nested form:
# [llm]
# deepseek_api_key = ""
# deepseek_model = "deepseek-v4-flash"
# deepseek_report_model = "deepseek-v4-flash"
# deepseek_grounding_model = "deepseek-v4-flash"
# COMPANIONGUARD_INTEGRATED_REPORT_*
