{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanionGuard v4 Judge Batch Output Wrapper",
  "type": "object",
  "required": [
    "case_id",
    "criterion_id",
    "judge_template",
    "status",
    "judge",
    "attempts",
    "result",
    "error"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "criterion_id": {
      "type": "string"
    },
    "criterion_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "judge_template": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "judge": {
      "type": "object",
      "description": "Provider/model/prompt/configuration provenance."
    },
    "attempts": {
      "type": "integer"
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "description": "Template-specific validated Judge JSON."
    },
    "raw_content": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_content_saved": {
      "type": "boolean",
      "const": false
    },
    "condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "product": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_log": {
      "type": "array"
    },
    "elapsed_seconds": {
      "type": "number"
    }
  }
}