{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanionGuard v4 Judge Batch Input",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id",
    "criterion_id",
    "conversation"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "criterion_id": {
      "type": "string"
    },
    "condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "product": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "description": "For single-turn cases. If omitted, criterion_id is used."
    },
    "conversation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "turn",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "turn": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "description": "Optional. Defaults: core/HR02 A4,A5; MR A_R1,A_R2; single-turn A1."
    },
    "metadata": {
      "type": "object"
    }
  }
}