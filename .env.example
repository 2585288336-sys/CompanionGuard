# Role-specific server LLM profiles. Keys stay server-side.
COMPANIONGUARD_JUDGE_PROVIDER_TYPE=openai_responses
COMPANIONGUARD_JUDGE_PROVIDER_NAME=DeepSeek
COMPANIONGUARD_JUDGE_BASE_URL=https://api.deepseek.com
COMPANIONGUARD_JUDGE_MODEL=deepseek-v4-pro
COMPANIONGUARD_JUDGE_API_KEY=
COMPANIONGUARD_JUDGE_REASONING_EFFORT=none
COMPANIONGUARD_JUDGE_TEMPERATURE=0

# Optional independent profiles for the other three LLM roles.
COMPANIONGUARD_EVIDENCE_PROVIDER_TYPE=openai_chat_compatible
COMPANIONGUARD_EVIDENCE_PROVIDER_NAME=
COMPANIONGUARD_EVIDENCE_BASE_URL=
COMPANIONGUARD_EVIDENCE_MODEL=
COMPANIONGUARD_EVIDENCE_API_KEY=

COMPANIONGUARD_DIALOGUE_REPORT_PROVIDER_TYPE=openai_chat_compatible
COMPANIONGUARD_DIALOGUE_REPORT_PROVIDER_NAME=
COMPANIONGUARD_DIALOGUE_REPORT_BASE_URL=
COMPANIONGUARD_DIALOGUE_REPORT_MODEL=
COMPANIONGUARD_DIALOGUE_REPORT_API_KEY=

COMPANIONGUARD_INTEGRATED_REPORT_PROVIDER_TYPE=openai_chat_compatible
COMPANIONGUARD_INTEGRATED_REPORT_PROVIDER_NAME=
COMPANIONGUARD_INTEGRATED_REPORT_BASE_URL=
COMPANIONGUARD_INTEGRATED_REPORT_MODEL=
COMPANIONGUARD_INTEGRATED_REPORT_API_KEY=

# Lightweight protection for server-funded LLM calls.
COMPANIONGUARD_SERVER_LLM_ENABLED=1
COMPANIONGUARD_SERVER_LLM_DAILY_CALL_LIMIT=500
COMPANIONGUARD_SERVER_LLM_SESSION_CALL_LIMIT=50

# Legacy fallback remains accepted for judge/evidence migration.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
